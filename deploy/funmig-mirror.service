[Unit]
Description=funmig mirror (gunicorn) - mirror.funmig.com
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/funmig/mirror
EnvironmentFile=/srv/funmig/mirror/.env
ExecStart=/srv/funmig/mirror/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8020 --workers 2 --timeout 300
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
