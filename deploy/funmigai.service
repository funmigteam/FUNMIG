[Unit]
Description=FUNMIGAI (gunicorn) - ai.funmig.com
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/funmig/FUNMIGAI
ExecStart=/srv/funmig/FUNMIGAI/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8012 --workers 2 --threads 4 --timeout 300
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
