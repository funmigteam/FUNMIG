map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      https;
}
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name funmig.com www.funmig.com social.funmig.com;
    client_max_body_size 100m;
    server_tokens off;

    location /static/ { alias /srv/funmig/funmig/staticfiles/; expires 30d; add_header Cache-Control "public"; access_log off; }
    location /media/  { alias /srv/funmig/funmig/media/; expires 30d; add_header Cache-Control "public"; log_not_found off; }
    location = /favicon.ico { alias /srv/funmig/funmig/staticfiles/favicon.ico; access_log off; log_not_found off; }
    location = /robots.txt  { alias /srv/funmig/funmig/staticfiles/robots.txt; access_log off; log_not_found off; }

    location / {
        proxy_pass http://127.0.0.1:8003;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}

server {
    listen 80;
    server_name prof.funmig.com;
    return 301 https://funmig.com$request_uri;
}

server {
    listen 80;
    server_name ai.funmig.com;
    client_max_body_size 50m;
    server_tokens off;

    location /static/ { alias /srv/funmig/FUNMIGAI/staticfiles/; expires 365d; add_header Cache-Control "public, immutable"; access_log off; }
    location /media/  { alias /srv/funmig/FUNMIGAI/media/; expires 30d; add_header Cache-Control "public"; log_not_found off; }
    location = /favicon.ico { alias /srv/funmig/FUNMIGAI/staticfiles/favicon.ico; access_log off; log_not_found off; }

    location / {
        proxy_pass http://127.0.0.1:8012;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}

server {
    listen 80;
    server_name mirror.funmig.com;
    client_max_body_size 20m;
    server_tokens off;

    location /static/ { alias /srv/funmig/mirror/staticfiles/; expires 30d; access_log off; }
    location /_mirror_blobs/ { internal; alias /srv/mirror-data/blobs/sha256/; }

    location / {
        proxy_pass http://127.0.0.1:8020;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 300s;
    }
}
